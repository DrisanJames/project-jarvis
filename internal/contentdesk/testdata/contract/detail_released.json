    "package": {
      "blocks": [
        {
          "id": "b1",
          "text": "Most savers can put $7,000 into an IRA for 2026. The limit is shared across all of your IRAs.",
          "type": "lede"
        },
        {
          "heading": "Who the limit applies to",
          "id": "b2",
          "text": "The limit applies to people with earned income. You cannot contribute more than you earned.",
          "type": "section"
        },
        {
          "id": "b3",
          "items": [
            "Check your earned income first.",
            "The limit is shared across traditional and Roth IRAs."
          ],
          "type": "key_takeaways"
        },
        {
          "calc": {
            "formula": "traditional + roth",
            "inputs": [
              {
                "name": "traditional",
                "value": 4000
              },
              {
                "name": "roth",
                "value": 3000
              }
            ],
            "result": 7000
          },
          "caption": "Together the two contributions stay within the limit.",
          "heading": "Splitting the limit across two IRAs",
          "id": "b4",
          "text": "Suppose you fund a traditional IRA and a Roth IRA in the same year.",
          "type": "worked_example"
        },
        {
          "heading": "Where contributions are reported",
          "id": "b5",
          "items": [
            "Box 1 shows traditional IRA contributions.",
            "Box 10 shows Roth IRA contributions."
          ],
          "text": "Your IRA custodian reports contributions on Form 5498.",
          "type": "document_anatomy"
        },
        {
          "caption": "Savers aged 50 and over can add a catch-up contribution.",
          "heading": "$7,000",
          "id": "b6",
          "text": "The 2026 IRA contribution limit.",
          "type": "stat"
        },
        {
          "caption": "Both accounts count toward the same limit.",
          "heading": "Traditional and Roth IRAs",
          "id": "b7",
          "rows": [
            [
              "Feature",
              "Traditional",
              "Roth"
            ],
            [
              "Contributions",
              "Often deductible",
              "Not deductible"
            ],
            [
              "Qualified withdrawals",
              "Taxed as income",
              "Tax-free"
            ]
          ],
          "type": "comparison_table"
        },
        {
          "heading": "How to stay under the limit",
          "id": "b8",
          "items": [
            "Add up every IRA contribution for the year.",
            "Compare the total with the limit.",
            "Withdraw any excess before your tax deadline."
          ],
          "type": "steps"
        },
        {
          "heading": "Common questions",
          "id": "b9",
          "items": [
            "Can I contribute to a traditional and a Roth IRA in the same year?",
            "Yes, but the combined total cannot exceed the limit.",
            "Does a workplace plan count toward the IRA limit?",
            "No, workplace plans have their own separate limit."
          ],
          "type": "faq"
        },
        {
          "caption": "IRS contribution guidance",
          "id": "b10",
          "text": "The limit applies per person, not per account.",
          "type": "pull_quote"
        },
        {
          "heading": "Check before you contribute",
          "id": "b11",
          "text": "Excess contributions are taxed every year until you remove them.",
          "type": "callout"
        }
      ],
